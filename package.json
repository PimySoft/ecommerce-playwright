{
  "name": "e-commerce-playwright",
  "version": "1.0.0",
  "description": "Playwright automation tests for e-commerce playground",
  "scripts": {
    "test": "playwright test",
    "test:headless": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chrome": "playwright test --project=chrome",
    "test:chrome:headed": "playwright test --project=chrome --headed",
    "test:firefox": "playwright test --project=firefox",
    "test:firefox:headed": "playwright test --project=firefox --headed",
    "test:safari": "playwright test --project=safari",
    "test:safari:headed": "playwright test --project=safari --headed",
    "test:percy": "percy exec -- playwright test tests/percy-visual.spec.ts",
    "test:percy:all": "percy exec -- playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@percy/cli": "^1.27.4",
    "@percy/playwright": "^1.0.9",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.2"
  }
}
