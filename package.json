{
  "name": "e-commerce-playwright",
  "version": "1.0.0",
  "description": "Playwright end-to-end tests for the automationexercise.com demo shop",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chrome": "playwright test --project=chrome",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=safari",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "bash scripts/run-visual-in-docker.sh",
    "test:visual:update": "bash scripts/run-visual-in-docker.sh --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "history:collect": "tsx scripts/collect-test-history.ts",
    "history:summarise": "tsx scripts/summarise-test-history.ts",
    "history:trends": "tsx scripts/render-trend-page.ts",
    "history:push-agent-runs": "bash scripts/push-agent-runs.sh",
    "review:prepare": "bash scripts/review/prepare-review.sh",
    "review:report": "tsx scripts/report-review-findings.ts",
    "review:feedback": "tsx scripts/review-feedback.ts",
    "eval:test-reviewer": "tsx scripts/eval-test-reviewer.ts",
    "plan:report": "tsx scripts/report-test-plan.ts",
    "plan:check-approval": "tsx scripts/check-plan-approval.ts",
    "proof:verify": "tsx scripts/verify-failure-proof.ts",
    "eval:test-planner": "tsx scripts/eval-test-planner.ts",
    "eval:failure-proof": "tsx scripts/eval-failure-proof.ts"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "automation"
  ],
  "author": "Rocco Salvetti",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.57.0",
    "@types/node": "^20.10.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "tsx": "4.19.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.2"
  }
}
